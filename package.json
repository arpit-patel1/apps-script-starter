{
  "author": "Amit Agarwal <amit@labnol.org> (https://www.labnol.org)",
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "apps-script-oauth2": "github:googleworkspace/apps-script-oauth2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "description": "Setup a local development environment for Google Apps Script with Visual Studio Code",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.2",
    "query-string": "^9.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-static-copy": "^4.0.1"
  },
  "homepage": "https://digitalinspiration.com/",
  "keywords": [
    "google-apps-script",
    "google-workspace"
  ],
  "license": "MIT",
  "name": "apps-script-starter",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.client.ts",
    "build:server": "vite build --config vite.config.server.js",
    "deploy": "npm run build && npm run upload",
    "dev": "vite --config vite.config.client.ts --mode development",
    "dev:server": "vite build --config vite.config.server.js --mode development --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "postbuild": "npx prettier --write \"dist/**/*.js\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "upload": "npx clasp push"
  },
  "type": "module",
  "version": "15.0.0"
}
